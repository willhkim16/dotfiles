# Private hosts (home IPs, NYU NetID) live in ~/.ssh/config.local, which isn't in
# this public repo. Include must come before any Host line, or it only applies
# inside that Host block. A missing file is skipped silently.
Include config.local

# NYU Courant (CIMS). Settings shared by every cims-* host:
Host cims-*
	# Reuse one open gateway login for hours instead of re-typing the NYU password per connection
	ControlMaster auto
	ControlPath ~/.ssh/sockets/%r@%h:%p
	ControlPersist 8h

Host cims-access
	HostName access.cims.nyu.edu

# The crunchy servers are only reachable from inside NYU, so hop through the gateway
Host cims-crunchy*
	ProxyJump cims-access

Host cims-crunchy1
	HostName crunchy1.cims.nyu.edu

Host cims-crunchy2
	HostName crunchy2.cims.nyu.edu

Host cims-crunchy5
	HostName crunchy5.cims.nyu.edu

Host cims-crunchy6
	HostName crunchy6.cims.nyu.edu

# Defaults for every host (keep at the bottom: ssh uses the FIRST value it finds)
Host *
	AddKeysToAgent 8h
