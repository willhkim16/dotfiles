#!/bin/bash
# usage: discordify clip.mp4 [target_MB]
set -euo pipefail
in="$1"; target=${2:-19}; abr=96
out="${in%.*}_discord.mp4"
dur=$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$in")
vbr=$(echo "$target*8192/$dur - $abr" | bc)
log="${in%.*}"
quiet=(-hide_banner -loglevel error -stats)
echo "pass 1/2: ${dur%.*}s clip -> ${vbr}k video + ${abr}k audio"
ffmpeg "${quiet[@]}" -y -i "$in" -vf scale=-2:720 -c:v libx264 -preset slow -b:v ${vbr}k -pass 1 -passlogfile "$log" -an -f null /dev/null
echo "pass 2/2"
ffmpeg "${quiet[@]}" -i "$in" -vf scale=-2:720 -c:v libx264 -preset slow -b:v ${vbr}k -pass 2 -passlogfile "$log" -c:a aac -b:a ${abr}k "$out"
rm -f "$log"-0.log "$log"-0.log.mbtree
echo "wrote $out ($(du -h "$out" | cut -f1))"
