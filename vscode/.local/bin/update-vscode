#!/bin/bash
# Update visual-studio-code-bin from the AUR; pacman -Syu doesn't cover it.
# An AUR recipe runs on this machine, so show what changed in it before building.
set -euo pipefail

pkg=visual-studio-code-bin
repo=${XDG_CACHE_HOME:-$HOME/.cache}/aur/$pkg

if [[ ! -d $repo/.git ]]; then
	git clone --quiet "https://aur.archlinux.org/$pkg.git" "$repo"
	cd "$repo"
	echo "First build from this clone: read the whole recipe."
	# nullglob: a pattern with no matches expands to nothing, not itself, so cat
	# (and set -e) don't fail if the recipe stops shipping a .sh or .install file
	shopt -s nullglob
	cat PKGBUILD ./*.sh ./*.install
	base=
else
	cd "$repo"
	git fetch --quiet
	base=HEAD
fi

installed=$(pacman -Q "$pkg" 2>/dev/null | cut -d' ' -f2 || true)
available=$(git show '@{u}:PKGBUILD' | sed -n 's/^pkgver=//p;s/^pkgrel=//p' | paste -sd-)
if [[ $installed == "$available" ]]; then
	echo "$pkg $installed is up to date."
	exit 0
fi
echo "$pkg: installed ${installed:-none}, available $available"

if [[ -n $base ]] && ! git diff --quiet "$base" '@{u}'; then
	git --no-pager log --format='%h %ad %an: %s' --date=short "$base..@{u}"
	git --no-pager diff "$base" '@{u}'
fi

read -rp "Build and install $available? [y/N] " ok
[[ $ok == [yY] ]] || exit 1

# Take the password now, while someone is at the keyboard. Prompting after the
# download and build means it can time out unanswered and waste the build.
sudo -v

git merge --ff-only --quiet '@{u}'

# Build and install separately rather than makepkg -i, so that if the install
# fails (sudo timed out, pacman was locked...) rerunning the script picks up the
# package it already built instead of downloading and packaging again.
built=$(makepkg --packagelist)
if [[ -f $built ]]; then
	echo "Reusing the package built earlier: ${built##*/}"
else
	makepkg -sc
fi
sudo pacman -U "$built"

# Each version's .deb and package are ~600 MB together; nothing needs them after
# install. set -e skips this if the install failed, which keeps the package for reuse.
rm -f ./*.deb "$built"
